# ==============================================
# TruthLens - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# --- LLM Configuration ---
# Any OpenAI-compatible API works (OpenAI, Groq, Together AI, Ollama, etc.)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# --- Tavily Web Search (Optional) ---
# If not set, TruthLens uses only the local knowledge base.
# TAVILY_API_KEY=your-tavily-key-here

# --- Qdrant Vector Database ---
# Leave empty to use in-memory mode (no server needed).
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- MongoDB (Optional) ---
# If not set, verification history is not persisted.
# MONGODB_URI=mongodb://localhost:27017
